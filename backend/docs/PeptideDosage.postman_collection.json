      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const postId = pm.collectionVariables.get('postId');",
          "const postid = pm.collectionVariables.get('postid');",
          "if (postId && !postid) { pm.collectionVariables.set('postid', postId); }",
          "if (postid && !postId) { pm.collectionVariables.set('postId', postid); }",
          "const accessToken = pm.collectionVariables.get('accessToken');",
          "const reqUrl = pm.request.url.toString();",
          "if (accessToken && !reqUrl.includes('/auth/')) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + accessToken });",
          "}"
        ]
      }
    }
